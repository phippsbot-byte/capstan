+"""CPU-only checks for the default-off SSD expert residency-cache prototype."""
+
+from __future__ import annotations
+
+import ast
+import copy
+import gc
+import importlib.util
+import os
+from pathlib import Path
+import sys
+import unittest
+import weakref
+
+
+_ROOT = Path(__file__).resolve().parents[1]
+_CACHE_PATH = (
+    _ROOT
+    / "omlx/patches/mlx_vlm_qwen4_exp_compat/vendor/mlx_vlm/models/qwen4_exp"
+    / "expert_residency_cache.py"
+)
+_SSD_PATH = _CACHE_PATH.with_name("ssd_experts.py")
+
+
+def _load_cache_module():
+    spec = importlib.util.spec_from_file_location("_test_expert_residency_cache", _CACHE_PATH)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+class _FakeModule:
+    def freeze(self):
+        self.frozen = True
+
+
+class _FakeQuantizedSwitchLinear(_FakeModule):
+    pass
+
+
+class _FakeNn:
+    Module = _FakeModule
+
+
+class _FakeMx:
+    @staticmethod
+    def concatenate(values, axis):
+        assert axis == 0
+        return ("concat", tuple(values))
+
+
+def _compiled_store_methods():
+    tree = ast.parse(_SSD_PATH.read_text(encoding="utf-8"))
+    store = next(
+        node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "_ExpertStore"
+    )
+    wanted = {"_cached_expert_rows", "projection"}
+    methods = [copy.deepcopy(node) for node in store.body if getattr(node, "name", None) in wanted]
+    assert {method.name for method in methods} == wanted
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            *methods,
+        ],
+        type_ignores=[],
+    )
+    namespace = {
+        "QuantizedSwitchLinear": _FakeQuantizedSwitchLinear,
+        "nn": _FakeNn,
+        "mx": _FakeMx,
+        "_PROJECTIONS": ("gate_proj", "up_proj", "down_proj"),
+        "_SUFFIXES": ("weight", "scales", "biases"),
+    }
+    exec(compile(ast.fix_missing_locations(module), str(_SSD_PATH), "exec"), namespace)
+    return namespace["_cached_expert_rows"], namespace["projection"]
+
+
+class ExpertResidencyCacheTests(unittest.TestCase):
+    def setUp(self):
+        self.cache_module = _load_cache_module()
+        self.cache_module._reset_shared_expert_cache_for_tests()
+
+    def tearDown(self):
+        self.cache_module._reset_shared_expert_cache_for_tests()
+
+    def test_default_off_and_invalid_configuration(self):
+        cache = self.cache_module.ExpertResidencyCache(0)
+        calls = []
+
+        values = cache.values_for(
+            1, [4, 4], 3, lambda expert: calls.append(expert) or (expert, object())
+        )
+
+        self.assertEqual(calls, [4, 4])
+        self.assertEqual([value[0] for value in values], [4, 4])
+        self.assertEqual(cache.stats()["resident_bytes"], 0)
+        self.assertEqual(self.cache_module.parse_cache_budget(None), 0)
+        self.assertEqual(self.cache_module.parse_cache_budget(""), 0)
+        for value in ("-1", " 1", "1 ", "1.5", "+1", "abc"):
+            with self.assertRaises(ValueError, msg=value):
+                self.cache_module.parse_cache_budget(value)
+
+    def test_same_namespace_hits_and_cross_namespace_cannot_alias(self):
+        cache = self.cache_module.ExpertResidencyCache(20)
+        calls = []
+
+        first = cache.get_or_load(10, 3, 5, lambda expert: calls.append((10, expert)) or object())
+        again = cache.get_or_load(10, 3, 5, lambda expert: calls.append((10, expert)) or object())
+        other = cache.get_or_load(11, 3, 5, lambda expert: calls.append((11, expert)) or object())
+
+        self.assertIs(first, again)
+        self.assertIsNot(first, other)
+        self.assertEqual(calls, [(10, 3), (11, 3)])
+        self.assertEqual(cache.stats()["hits"], 1)
+
+    def test_mixed_sizes_exact_recency_eviction_and_accounting(self):
+        cache = self.cache_module.ExpertResidencyCache(10)
+        loads = []
+
+        def load(expert):
+            loads.append(expert)
+            return f"expert-{expert}-{len(loads)}"
+
+        cache.get_or_load(1, 1, 3, load)  # A: [A]
+        cache.get_or_load(1, 2, 4, load)  # B: [A, B]
+        cache.get_or_load(1, 1, 3, load)  # touch A: [B, A]
+        cache.get_or_load(1, 3, 4, load)  # C: evict B => [A, C]
+        stats = cache.stats()
+        self.assertEqual(stats["resident_bytes"], 7)
+        self.assertEqual(stats["entry_count"], 2)
+        self.assertEqual(stats["evictions"], 1)
+        cache.get_or_load(1, 2, 4, load)  # B was the exact LRU and reloads.
+        self.assertEqual(loads, [1, 2, 3, 2])
+        self.assertEqual(cache.stats()["resident_bytes"], 8)
+        self.assertEqual(cache.stats()["entry_count"], 2)
+
+    def test_oversize_bypasses_without_evicting_useful_entries(self):
+        cache = self.cache_module.ExpertResidencyCache(8)
+        cached = cache.get_or_load(1, 1, 4, lambda _: object())
+        oversized = cache.get_or_load(1, 2, 9, lambda _: object())
+
+        self.assertIs(cached, cache.get_or_load(1, 1, 4, lambda _: object()))
+        self.assertNotEqual(cached, oversized)
+        self.assertEqual(cache.stats()["resident_bytes"], 4)
+        self.assertEqual(cache.stats()["entry_count"], 1)
+        self.assertEqual(cache.stats()["bypasses"], 1)
+
+    def test_loader_failure_does_not_charge_or_evict_and_can_retry(self):
+        cache = self.cache_module.ExpertResidencyCache(8)
+        survivor = cache.get_or_load(1, 1, 4, lambda _: object())
+        attempts = 0
+
+        def flaky(_):
+            nonlocal attempts
+            attempts += 1
+            if attempts == 1:
+                raise RuntimeError("fixture read failure")
+            return object()
+
+        with self.assertRaisesRegex(RuntimeError, "fixture read failure"):
+            cache.get_or_load(1, 2, 4, flaky)
+        self.assertEqual(cache.stats()["resident_bytes"], 4)
+        self.assertIs(survivor, cache.get_or_load(1, 1, 4, lambda _: object()))
+        loaded = cache.get_or_load(1, 2, 4, flaky)
+        self.assertIs(loaded, cache.get_or_load(1, 2, 4, flaky))
+        self.assertEqual(attempts, 2)
+        self.assertEqual(cache.stats()["resident_bytes"], 8)
+
+    def test_values_for_preserves_route_order_and_duplicates(self):
+        cache = self.cache_module.ExpertResidencyCache(30)
+        loaded = []
+        values = cache.values_for(
+            22,
+            [3, 1, 3, 2],
+            5,
+            lambda expert: loaded.append(expert) or f"group-{expert}",
+        )
+
+        self.assertEqual(values, ["group-3", "group-1", "group-3", "group-2"])
+        self.assertEqual(loaded, [3, 1, 2])
+        self.assertEqual(cache.stats()["resident_bytes"], 15)
+
+    def test_shared_cache_is_one_per_process_and_namespace_does_not_retain_instance(self):
+        old = os.environ.get(self.cache_module.CACHE_BUDGET_ENV)
+        os.environ[self.cache_module.CACHE_BUDGET_ENV] = "12"
+        try:
+            first = self.cache_module.get_shared_expert_cache()
+            second = self.cache_module.get_shared_expert_cache()
+            self.assertIs(first, second)
+            self.assertIsNotNone(first)
+            first_namespace = self.cache_module.new_expert_bank_namespace()
+            second_namespace = self.cache_module.new_expert_bank_namespace()
+            self.assertNotEqual(first_namespace, second_namespace)
+
+            class Bank:
+                pass
+
+            bank = Bank()
+            bank_ref = weakref.ref(bank)
+            first.get_or_load(first_namespace, 7, 4, lambda _: "first-bank")
+            del bank
+            gc.collect()
+            self.assertIsNone(bank_ref())
+            self.assertEqual(first.discard_namespace(first_namespace), 1)
+            self.assertEqual(first.stats()["resident_bytes"], 0)
+            self.assertEqual(
+                first.get_or_load(second_namespace, 7, 4, lambda _: "second-bank"),
+                "second-bank",
+            )
+            os.environ[self.cache_module.CACHE_BUDGET_ENV] = "13"
+            with self.assertRaisesRegex(RuntimeError, "already initialized"):
+                self.cache_module.get_shared_expert_cache()
+        finally:
+            if old is None:
+                os.environ.pop(self.cache_module.CACHE_BUDGET_ENV, None)
+            else:
+                os.environ[self.cache_module.CACHE_BUDGET_ENV] = old
+
+    def test_extracted_ssd_callsite_keeps_off_path_and_enabled_route_order(self):
+        cached_rows, projection = _compiled_store_methods()
+        cache = self.cache_module.ExpertResidencyCache(100)
+
+        class Store:
+            cache_namespace = 9
+            _expert_entry_bytes = 9
+            prefix = "bank"
+            group_size = 64
+            bits = 4
+            mode = "affine"
+            _expert_cache_keys = tuple(
+                f"{projection}.{suffix}"
+                for projection in ("gate_proj", "up_proj", "down_proj")
+                for suffix in ("weight", "scales", "biases")
+            )
+
+            def __init__(self):
+                self.direct_reads = []
+                self.loads = []
+
+            def read_rows(self, key, rows):
+                self.direct_reads.append((key, tuple(rows)))
+                return ("direct", key, tuple(rows))
+
+            def _read_expert(self, expert):
+                self.loads.append(expert)
+                return tuple(f"{expert}:{key}" for key in self._expert_cache_keys)
+
+        Store._cached_expert_rows = cached_rows
+        Store.projection = projection
+        store = Store()
+
+        direct = store.projection("up_proj", [5, 2], cache=None)
+        self.assertEqual(
+            store.direct_reads,
+            [
+                ("bank.up_proj.weight", (5, 2)),
+                ("bank.up_proj.scales", (5, 2)),
+                ("bank.up_proj.biases", (5, 2)),
+            ],
+        )
+        self.assertEqual(direct.weight, ("direct", "bank.up_proj.weight", (5, 2)))
+
+        enabled = store.projection("up_proj", [5, 2], cache=cache)
+        reordered = store.projection("up_proj", [2, 5], cache=cache)
+        self.assertEqual(store.loads, [5, 2])
+        self.assertEqual(
+            enabled.weight,
+            ("concat", ("5:up_proj.weight", "2:up_proj.weight")),
+        )
+        self.assertEqual(
+            reordered.weight,
+            ("concat", ("2:up_proj.weight", "5:up_proj.weight")),
+        )
+        self.assertTrue(enabled.frozen)
+        self.assertTrue(hasattr(enabled, "_ssd_cache_staging"))
+
+
+if __name__ == "__main__":
+    unittest.main()
