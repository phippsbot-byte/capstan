@@ -0,0 +1,193 @@
+"""Process-shared, opt-in LRU residency for exact SSD expert row groups.
+
+This module deliberately has no MLX dependency: values are opaque references.
+The configured budget counts resident cached values only; request assembly is
+outside that accounting.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from dataclasses import dataclass
+from functools import wraps
+import itertools
+import os
+from threading import RLock
+from typing import Callable, TypeVar
+
+
+CACHE_BUDGET_ENV = "OMLX_QWEN4_SSD_EXPERT_CACHE_BYTES"
+
+_Value = TypeVar("_Value")
+
+
+def _synchronized(method):
+    @wraps(method)
+    def guarded(self, *args, **kwargs):
+        with self._lock:
+            return method(self, *args, **kwargs)
+    return guarded
+
+
+def parse_cache_budget(value: str | None) -> int:
+    """Parse an explicit non-negative integer byte budget; unset and empty are off."""
+    if value is None or value == "":
+        return 0
+    if not value.isascii() or not value.isdecimal():
+        raise ValueError(f"{CACHE_BUDGET_ENV} must be a non-negative integer byte count")
+    return int(value)
+
+
+@dataclass(frozen=True)
+class _Entry:
+    value: object
+    byte_count: int
+
+
+class ExpertResidencyCache:
+    """Strict byte-bounded LRU keyed by a fresh bank namespace and expert id."""
+
+    def __init__(self, budget_bytes: int):
+        if type(budget_bytes) is not int or budget_bytes < 0:
+            raise ValueError("SSD expert cache budget must be a non-negative integer")
+        self.budget_bytes = budget_bytes
+        self._lock = RLock()
+        self._entries: OrderedDict[tuple[int, int], _Entry] = OrderedDict()
+        self._retired_namespaces: set[int] = set()
+        self._resident_bytes = 0
+        self._hits = 0
+        self._misses = 0
+        self._evictions = 0
+        self._bypasses = 0
+
+    @_synchronized
+    def get_or_load(
+        self,
+        namespace: int,
+        expert: int,
+        byte_count: int,
+        loader: Callable[[int], _Value],
+    ) -> _Value:
+        """Return an exact group, only admitting it after its loader succeeds."""
+        if type(namespace) is not int or type(expert) is not int:
+            raise TypeError("SSD expert cache keys must be integer namespace/expert pairs")
+        if type(byte_count) is not int or byte_count <= 0:
+            raise ValueError("SSD expert cache entry size must be a positive integer")
+        if namespace in self._retired_namespaces:
+            raise RuntimeError("SSD expert cache bank namespace is retired")
+        key = (namespace, expert)
+        entry = self._entries.get(key)
+        if entry is not None:
+            if entry.byte_count != byte_count:
+                raise ValueError("SSD expert cache entry byte contract changed")
+            self._entries.move_to_end(key)
+            self._hits += 1
+            return entry.value  # type: ignore[return-value]
+
+        self._misses += 1
+        value = loader(expert)
+        if byte_count > self.budget_bytes:
+            self._bypasses += 1
+            return value
+
+        while self._resident_bytes + byte_count > self.budget_bytes:
+            _, evicted = self._entries.popitem(last=False)
+            self._resident_bytes -= evicted.byte_count
+            self._evictions += 1
+        self._entries[key] = _Entry(value, byte_count)
+        self._resident_bytes += byte_count
+        return value
+
+    def values_for(
+        self,
+        namespace: int,
+        experts: list[int],
+        byte_count: int,
+        loader: Callable[[int], _Value],
+    ) -> list[_Value]:
+        """Fetch groups in caller order, including duplicate expert ids."""
+        return [
+            self.get_or_load(namespace, expert, byte_count, loader)
+            for expert in experts
+        ]
+
+    @_synchronized
+    def discard_namespace(self, namespace: int) -> int:
+        """Evict values without retiring a still-open bank."""
+        if type(namespace) is not int:
+            raise TypeError("SSD expert cache namespace must be an integer")
+        removed = 0
+        for key in tuple(self._entries):
+            if key[0] == namespace:
+                entry = self._entries.pop(key)
+                self._resident_bytes -= entry.byte_count
+                removed += 1
+        return removed
+
+    @_synchronized
+    def close_namespace(self, namespace: int, closer: Callable[[], None]) -> None:
+        """Retire, evict and close atomically against cold loaders.
+
+        Retirement survives a failing closer. Tombstones retain only monotonic
+        integer tokens, never bank objects or tensors; they are control metadata
+        outside the resident-tensor budget and disappear with the process.
+        Already-returned values remain owned by their consumer graphs.
+        """
+        if type(namespace) is not int:
+            raise TypeError("SSD expert cache namespace must be an integer")
+        if not callable(closer):
+            raise TypeError("SSD expert cache bank closer must be callable")
+        self._retired_namespaces.add(namespace)
+        self.discard_namespace(namespace)
+        closer()
+
+    @_synchronized
+    def stats(self) -> dict[str, int]:
+        """Return conserved resident accounting and cache event counters."""
+        return {
+            "budget_bytes": self.budget_bytes,
+            "resident_bytes": self._resident_bytes,
+            "entry_count": len(self._entries),
+            "retired_namespace_count": len(self._retired_namespaces),
+            "hits": self._hits,
+            "misses": self._misses,
+            "evictions": self._evictions,
+            "bypasses": self._bypasses,
+        }
+
+
+_namespace_counter = itertools.count(1)
+_shared_cache: ExpertResidencyCache | None = None
+_shared_budget: int | None = None
+_shared_lock = RLock()
+
+
+def new_expert_bank_namespace() -> int:
+    """Create a never-reused process-local token without retaining a bank object."""
+    return next(_namespace_counter)
+
+
+def get_shared_expert_cache() -> ExpertResidencyCache | None:
+    """Return the one process cache, or ``None`` for the default-off configuration."""
+    global _shared_cache, _shared_budget
+    with _shared_lock:
+        budget = parse_cache_budget(os.environ.get(CACHE_BUDGET_ENV))
+        if _shared_cache is None:
+            if budget == 0:
+                return None
+            _shared_cache = ExpertResidencyCache(budget)
+            _shared_budget = budget
+            return _shared_cache
+        if budget != _shared_budget:
+            raise RuntimeError(
+                f"{CACHE_BUDGET_ENV} was already initialized for this process; "
+                "restart to change its budget"
+            )
+        return _shared_cache
+
+
+def _reset_shared_expert_cache_for_tests() -> None:
+    """Test-only reset; production configuration is intentionally process-stable."""
+    global _shared_cache, _shared_budget
+    _shared_cache = None
+    _shared_budget = None
