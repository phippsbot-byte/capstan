+"""Parent CPU regressions for the process-shared cache."""
+from collections import OrderedDict
+import importlib.util,sys,threading,unittest
+from pathlib import Path
+P=Path(__file__).resolve().parents[1]/'omlx/patches/mlx_vlm_qwen4_exp_compat/vendor/mlx_vlm/models/qwen4_exp/expert_residency_cache.py'
+spec=importlib.util.spec_from_file_location('parent_cache_race',P)
+assert spec is not None and spec.loader is not None
+m=importlib.util.module_from_spec(spec);sys.modules[spec.name]=m;spec.loader.exec_module(m)
+class Tests(unittest.TestCase):
+ def test_hit_and_namespace_release_serialize(self):
+  cache=m.ExpertResidencyCache(100);value=cache.get_or_load(1,2,100,lambda _:object());entered=threading.Event();release=threading.Event();finished=threading.Event();errors=[];got=[]
+  class Paused(OrderedDict):
+   def move_to_end(self,key,last=True):entered.set();assert release.wait(3);return super().move_to_end(key,last=last)
+  cache._entries=Paused(cache._entries)
+  def hit():
+   try:got.append(cache.get_or_load(1,2,100,lambda _:None))
+   except BaseException as e:errors.append(e)
+  def discard():
+   try:cache.discard_namespace(1)
+   except BaseException as e:errors.append(e)
+   finally:finished.set()
+  a=threading.Thread(target=hit);b=threading.Thread(target=discard)
+  try:
+   a.start();self.assertTrue(entered.wait(2));b.start();finished.wait(.1)
+  finally:
+   release.set();a.join(3)
+   if b.ident is not None:b.join(3)
+  self.assertFalse(a.is_alive() or b.is_alive());self.assertEqual(errors,[]);self.assertEqual(got,[value]);self.assertEqual(cache.stats()['resident_bytes'],0)
+ def test_a_hit_rejects_a_different_byte_contract(self):
+  cache=m.ExpertResidencyCache(100);cache.get_or_load(1,2,80,lambda _:object())
+  with self.assertRaises(ValueError):cache.get_or_load(1,2,100,lambda _:None)
+  self.assertEqual(cache.stats()['resident_bytes'],80)
+if __name__=='__main__':unittest.main(verbosity=2)
