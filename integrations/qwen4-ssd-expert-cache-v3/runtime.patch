+"""Reviewer regression: selected pager close serializes with/rejects cold reloads."""
+import ast,copy,importlib.util,sys,threading,types,unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];P=ROOT/'omlx/patches/mlx_vlm_qwen4_exp_compat/vendor/mlx_vlm/models/qwen4_exp'
+spec=importlib.util.spec_from_file_location('parent_cache_retire',P/'expert_residency_cache.py')
+assert spec is not None and spec.loader is not None
+m=importlib.util.module_from_spec(spec);sys.modules[spec.name]=m;spec.loader.exec_module(m)
+tree=ast.parse((P/'ssd_experts.py').read_text());cls=next(x for x in tree.body if isinstance(x,ast.ClassDef)and x.name=='DiskBackedSwitchGLU');node=copy.deepcopy(next(x for x in cls.body if isinstance(x,ast.FunctionDef)and x.name=='close'));namespace={};exec(compile(ast.fix_missing_locations(ast.Module(body=[node],type_ignores=[])),str(P/'ssd_experts.py'),'exec'),namespace);close=namespace['close']
+class Tests(unittest.TestCase):
+ def test_actual_close_rejects_new_cold_load_after_retirement(self):
+  c=m.ExpertResidencyCache(100);c.get_or_load(1,1,80,lambda _:object());entered=threading.Event();release=threading.Event();loads=[];errors=[]
+  def close_store():entered.set();assert release.wait(3)
+  pager=types.SimpleNamespace(_expert_cache=c,_store=types.SimpleNamespace(cache_namespace=1,close=close_store))
+  def reload():
+   try:c.get_or_load(1,2,80,lambda e:loads.append(e)or object())
+   except Exception as e:errors.append(e)
+  a=threading.Thread(target=lambda:close(pager));b=threading.Thread(target=reload)
+  try:a.start();self.assertTrue(entered.wait(2));b.start();b.join(.1)
+  finally:
+   release.set();a.join(3)
+   if b.ident is not None:b.join(3)
+  self.assertFalse(a.is_alive()or b.is_alive());self.assertEqual(loads,[]);self.assertEqual(len(errors),1);self.assertIsInstance(errors[0],RuntimeError);self.assertEqual(c.stats()['resident_bytes'],0)
+ def test_failed_store_close_still_retires_namespace(self):
+  c=m.ExpertResidencyCache(100);c.get_or_load(1,1,80,lambda _:object())
+  def fail():raise OSError('synthetic close failure')
+  pager=types.SimpleNamespace(_expert_cache=c,_store=types.SimpleNamespace(cache_namespace=1,close=fail))
+  with self.assertRaises(OSError):close(pager)
+  with self.assertRaises(RuntimeError):c.get_or_load(1,2,80,lambda _:object())
+  self.assertEqual(c.stats()['resident_bytes'],0)
+if __name__=='__main__':unittest.main(verbosity=2)
