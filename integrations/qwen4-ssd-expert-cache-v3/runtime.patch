+import importlib.util,json,tempfile,unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+PATH=ROOT/'omlx/patches/mlx_vlm_qwen4_exp_compat/vendor/mlx_vlm/models/qwen4_exp/paging_profile.py'
+from typing import Any
+spec=importlib.util.spec_from_file_location('isolated_sink',PATH)
+if spec is None or spec.loader is None:raise RuntimeError('profile source loader unavailable')
+profile: Any=importlib.util.module_from_spec(spec)
+spec.loader.exec_module(profile)
+class Tests(unittest.TestCase):
+    def test_limit_is_bounded_128_mib(self):self.assertEqual(profile.MAX_FILE_BYTES,128*1024**2)
+    def test_actual_more_than_32_mib_of_records(self):
+        with tempfile.TemporaryDirectory() as td:
+            p=Path(td)/'trace.jsonl';w=profile.PagingProfileWriter(p)
+            try:
+                record={'data':'x'*32700}
+                for _ in range(2048):w.write(record)
+                self.assertGreater(p.stat().st_size,32*1024**2)
+                self.assertLess(p.stat().st_size,profile.MAX_FILE_BYTES)
+            finally:w.close()
+    def test_finite_limit_failure_stays_latched(self):
+        old=profile.MAX_FILE_BYTES;profile.MAX_FILE_BYTES=100
+        try:
+            with tempfile.TemporaryDirectory() as td:
+                w=profile.PagingProfileWriter(Path(td)/'trace.jsonl')
+                try:
+                    w.write({'data':'x'*50})
+                    with self.assertRaises(OSError):w.write({'data':'x'*50})
+                    with self.assertRaises(RuntimeError):w.write({})
+                finally:w.close()
+        finally:profile.MAX_FILE_BYTES=old
+    def test_record_limit_not_weakened(self):
+        with tempfile.TemporaryDirectory() as td:
+            w=profile.PagingProfileWriter(Path(td)/'trace.jsonl')
+            try:
+                with self.assertRaises(ValueError):w.write({'data':'x'*(64*1024)})
+            finally:w.close()
+if __name__=='__main__':unittest.main()
